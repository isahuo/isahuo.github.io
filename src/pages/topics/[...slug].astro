---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import PostPage from "@/components/layout/PostPage.astro";
import { profileConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

export async function getStaticPaths() {
	const topics = await getCollection("topics", ({ data }) => !data.draft);
	return topics.map((topic) => ({
		params: { slug: topic.id },
		props: { topic },
	}));
}

interface Props {
	topic: CollectionEntry<"topics">;
}

const { topic } = Astro.props as Props;
const allPosts = await getSortedPosts();
const topicPosts = allPosts
	.filter((post) => post.data.topics.includes(topic.id))
	.sort((a, b) => {
		const orderA =
			a.data.topicOrder > 0 ? a.data.topicOrder : Number.MAX_SAFE_INTEGER;
		const orderB =
			b.data.topicOrder > 0 ? b.data.topicOrder : Number.MAX_SAFE_INTEGER;
		return (
			orderA - orderB || b.data.published.getTime() - a.data.published.getTime()
		);
	});

const latestDate =
	topicPosts[0]?.data.updated ||
	topicPosts[0]?.data.published ||
	topic.data.updated ||
	topic.data.published;

const statusLabels = {
	planned: "计划中",
	ongoing: "持续更新",
	completed: "已完成",
} as const;
---

<MainGridLayout
  title={topic.data.title}
  description={topic.data.description}
>
  <!-- 专题是一张完整的“大纸张”，简介和文章都承载在同一底座上 -->
  <section class="topic-paper card-base px-5 md:px-7 py-6 md:py-7 mb-4">
    <header class="flex items-start gap-4">
      <div class="shrink-0 w-11 h-11 rounded-lg bg-(--btn-regular-bg) text-(--primary) flex items-center justify-center mt-0.5">
        <Icon is:inline name="material-symbols:deployed-code-outline-rounded" class="text-2xl" />
      </div>

      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <h1 class="text-2xl md:text-3xl font-bold text-90">{topic.data.title}</h1>
          <span class="px-2 py-0.5 rounded-md bg-(--btn-regular-bg) text-(--primary) text-xs font-medium">
            {statusLabels[topic.data.status]}
          </span>
        </div>

        <p class="text-50 leading-7 mb-4">{topic.data.description}</p>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-30">
          <span class="inline-flex items-center gap-1.5">
            <Icon is:inline name="material-symbols:person-outline-rounded" class="text-base" />
            作者：{profileConfig.name}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon is:inline name="material-symbols:article-outline-rounded" class="text-base" />
            共 {topicPosts.length} 篇文章
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon is:inline name="material-symbols:update-rounded" class="text-base" />
            最后更新：{formatDateToYYYYMMDD(latestDate)}
          </span>
        </div>
      </div>
    </header>

    <div class="border-(--line-divider) border-dashed border-t mt-6 pt-5">
      <div class="flex items-center justify-between gap-3 mb-4">
        <h2 class="text-xl font-bold text-90 inline-flex items-center gap-2">
          <Icon is:inline name="material-symbols:grid-view-rounded" class="text-(--primary)" />
          专题文章
        </h2>
        {topicPosts.length > 0 && <span class="text-sm text-30">按专题顺序排列</span>}
      </div>

      {topicPosts.length > 0 ? (
        <PostPage page={{ data: topicPosts }} fixedLayout="grid" />
      ) : (
        <div class="px-8 py-12 text-center rounded-xl border border-(--line-divider)">
          <Icon is:inline name="material-symbols:post-add-rounded" class="text-5xl text-30 mx-auto mb-4" />
          <p class="font-bold text-75 mb-2">专题内容正在整理</p>
          <p class="text-sm text-50">为文章填写该专题 ID 后，它会自动出现在这里。</p>
        </div>
      )}
    </div>
  </section>
</MainGridLayout>

<style>
  .topic-paper :global(#post-list-container) {
    margin-bottom: 0;
  }

  .topic-paper :global(.post-card-wrapper) {
    border-color: color-mix(in oklch, var(--line-divider) 85%, transparent);
  }
</style>
