---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";

const allTopics = await getCollection("topics", ({ data }) => !data.draft);
const allPosts = await getSortedPosts();

const topics = allTopics
	.map((topic) => {
		const posts = allPosts.filter((post) =>
			post.data.topics.includes(topic.id),
		);
		const latestDate =
			posts[0]?.data.updated ||
			posts[0]?.data.published ||
			topic.data.updated ||
			topic.data.published;
		return { topic, posts, latestDate };
	})
	.sort(
		(a, b) =>
			a.topic.data.order - b.topic.data.order ||
			b.latestDate.getTime() - a.latestDate.getTime(),
	);
---

<MainGridLayout
  title="专题文章"
  description="围绕长期关注的方向组织系列文章与项目内容"
>
  <section class="card-base px-6 md:px-8 py-6 mb-4">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-10 h-10 rounded-lg bg-(--btn-regular-bg) text-(--primary) flex items-center justify-center">
        <Icon is:inline name="material-symbols:topic-outline-rounded" class="text-2xl" />
      </div>
      <h1 class="text-2xl font-bold text-90">专题文章</h1>
    </div>
    <p class="text-50 leading-7">
      将系列文章与项目按主题聚合，便于持续学习、系统整理和集中查阅。
    </p>
  </section>

  <div class="flex flex-col gap-4 mb-4">
    {topics.map(({ topic, posts, latestDate }, index) => (
      <a
        href={`/topics/${topic.id}/`}
        class="topic-card card-base px-6 py-5 md:px-7 md:py-6 group onload-animation"
        style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
      >
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-lg bg-(--btn-regular-bg) text-(--primary) flex items-center justify-center mt-0.5">
            <Icon is:inline name="material-symbols:deployed-code-outline-rounded" class="text-2xl" />
          </div>

          <div class="flex-1 min-w-0">
            <h2 class="text-lg md:text-xl font-bold text-90 group-hover:text-(--primary) transition-colors mb-2">
              {topic.data.title}
            </h2>
            <p class="text-50 leading-6 mb-3">{topic.data.description}</p>

            <div class="text-sm text-30 flex flex-wrap items-center gap-x-4 gap-y-1">
              {posts.length > 0 ? (
                <>
                  <span class="inline-flex items-center gap-1.5">
                    <Icon is:inline name="material-symbols:article-outline-rounded" class="text-base" />
                    {posts.length} 篇文章
                  </span>
                  <span>更新于 {formatDateToYYYYMMDD(latestDate)}</span>
                </>
              ) : (
                <span>内容筹备中</span>
              )}
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  {topics.length === 0 && (
    <section class="card-base px-8 py-12 text-center">
      <Icon is:inline name="material-symbols:topic-outline-rounded" class="text-5xl text-30 mx-auto mb-4" />
      <p class="font-bold text-75 mb-2">暂无专题</p>
      <p class="text-sm text-50">创建第一个专题后，它会显示在这里。</p>
    </section>
  )}
</MainGridLayout>

<style>
  .topic-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .topic-card:hover {
    transform: translateY(-2px);
  }
</style>
